# Локальная конфигурация docker-compose.
# Скопируйте в .env (файл .env в git не попадает) и замените значения.
# Все переменные необязательны: без .env compose использует dev-дефолты.

# PostgreSQL
POSTGRES_DB=uniplanner_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
# JWT_SECRET: минимум 256 бит (32 байта) для HS256; сгенерировать: openssl rand -base64 32
JWT_SECRET=dev-secret-key-change-in-production-min-256-bits-long-for-hs256
# Ключ шифрования cookie-сессий ИС вуза (независим от JWT_SECRET)
UNIVERSITY_AUTH_ENCRYPTION_KEY=dev-university-auth-encryption-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
