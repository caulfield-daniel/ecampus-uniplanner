# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uniplanner_backend
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# ============================================
# JWT Configuration
# ============================================
# Минимум 256 бит (32 символа) для HS256
# Сгенерируйте безопасный ключ: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-long-please-change-in-production

# ============================================
# Parser Service
# ============================================
PARSER_BASE_URL=http://localhost:8000/api/v1

# ============================================
# University Auth (личные сессии ecampus.ncfu.ru)
# ============================================
# Ключ шифрования cookie-сессий at rest (отдельный от JWT_SECRET)
UNIVERSITY_AUTH_ENCRYPTION_KEY=your-university-auth-encryption-key-change-in-production

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000